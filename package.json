{
  "name": "ssh-connect",
  "displayName": "SSH Connect",
  "description": "Manage and Connect to SSH hosts directly in VS Code",
  "version": "0.2.0",
  "publisher": "elcamilet",
  "author": {
    "name": "Camilo Nevot",
    "email": "elcamilet@gmail.com",
    "url": "https://github.com/elcamilet/ssh-connect"
  },
  "icon": "icon.png",
  "repository": "https://github.com/elcamilet/ssh-connect.git",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:sshHostsView",
    "onCommand:ssh-connect.editConfig",
    "onCommand:ssh-connect.savePassword",
    "onCommand:ssh-connect.deletePassword"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sshHostsViewContainer",
          "title": "SSH Connect",
          "icon": "resources/viewContainerIcon.svg"
        }
      ]
    },
    "views": {
      "sshHostsViewContainer": [
        {
          "id": "sshHostsView",
          "name": "SSH Connect"
        }
      ]
    },
    "commands": [
      {
        "command": "ssh-connect.editConfig",
        "title": "Edit configuration file",
        "category": "SSH Connect",
        "icon": "resources/editConfig.svg"
      },
      {
        "command": "ssh-connect.savePassword",
        "title": "Save password for group or host",
        "category": "SSH Connect",
        "icon": "resources/savePassword.svg"
      },
      {
        "command": "ssh-connect.deletePassword",
        "title": "Delete saved password for group or host",
        "category": "SSH Connect",
        "icon": "resources/deletePassword.svg"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ssh-connect.editConfig",
          "when": "view == sshHostsView",
          "group": "navigation@1"
        },
        {
          "command": "ssh-connect.savePassword",
          "when": "view == sshHostsView",
          "group": "navigation@2"
        },
        {
          "command": "ssh-connect.deletePassword",
          "when": "view == sshHostsView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "ssh-connect.savePassword",
          "when": "view == sshHostsView && viewItem == host",
          "group": "inline@1"
        },
        {
          "command": "ssh-connect.deletePassword",
          "when": "view == sshHostsView && viewItem == host",
          "group": "inline@2"
        },
        {
          "command": "ssh-connect.savePassword",
          "when": "view == sshHostsView && viewItem == group",
          "group": "inline@1"
        },
        {
          "command": "ssh-connect.deletePassword",
          "when": "view == sshHostsView && viewItem == group",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check",
    "lint": "eslint .",
    "test": "node --test",
    "check": "npm run lint && npm test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
